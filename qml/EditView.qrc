<RCC>
    <qresource prefix="/qml/EditView">
        <file alias="DesignTokens.qml">EditView/DesignTokens.qml</file>
        <file alias="qmldir">EditView/qmldir</file>
        <file alias="Main.qml">EditView/Main.qml</file>
        <file alias="ParamForm.qml">EditView/ParamForm.qml</file>
        <file alias="PropertyPreviewPanel.qml">EditView/PropertyPreviewPanel.qml</file>
        <file alias="OperatorEditorDialog.qml">EditView/OperatorEditorDialog.qml</file>
        <file alias="OperatorTunerDialog.qml">EditView/OperatorTunerDialog.qml</file>
        <file alias="ROISelector.qml">EditView/ROISelector.qml</file>
        <!-- v3.1.0 新增组件 -->
        <file alias="FloatingPanel.qml">EditView/FloatingPanel.qml</file>
        <file alias="ImagePreviewWindow.qml">EditView/ImagePreviewWindow.qml</file>
        <file alias="AnnotateOverlay.qml">EditView/AnnotateOverlay.qml</file>
        <file alias="ResultTable.qml">EditView/ResultTable.qml</file>
        <!-- v2.5.0 新增组件：Halcon 风格图像浏览器 + 部署结果对话框 -->
        <file alias="ImageViewer.qml">EditView/ImageViewer.qml</file>
        <file alias="DeployDialog.qml">EditView/DeployDialog.qml</file>
        <!-- v3.2.0 算子参数编辑器增强：文件路径输入组件（修复：M8 修复空白界面） -->
        <file alias="FilePathField.qml">EditView/FilePathField.qml</file>
        <!-- v4.0 快捷键面板 -->
        <file alias="ShortcutsPanel.qml">EditView/ShortcutsPanel.qml</file>
        <!-- v2.6.0 新增组件：预览窗口 + 变量管理 -->
        <file alias="PreviewPanel.qml">EditView/PreviewPanel.qml</file>
        <file alias="VariableManagerPanel.qml">EditView/VariableManagerPanel.qml</file>
        <file alias="VarEditDialog.qml">EditView/VarEditDialog.qml</file>
    </qresource>
</RCC>
