/* =============================================================
 * QDetectVision 暗色主题样式表  v2.0（对齐 DesignTokens v3.0.0）
 * 由 main.cpp 在启动时加载。
 * ============================================================= */

/* 全局基色：背景 #1e1e1e，前景 #e0e0e0 */
QWidget { background-color: #1e1e1e; color: #e0e0e0; }
QMainWindow { background-color: #1e1e1e; }
QDialog { background-color: #1e1e1e; }

/* GroupBox：边框 + 标题留白 */
QGroupBox {
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
    font-weight: bold;
    color: #e0e0e0;
}
QGroupBox::title { color: #e0e0e0; subcontrol-origin: margin; left: 12px; }

/* 按钮：默认 / 悬停 / 按下 / 禁用 */
QPushButton {
    background-color: #3d3d3d;
    color: #e0e0e0;
    border: 1px solid #3D3D3D;
    padding: 6px 16px;
    border-radius: 4px;
}
QPushButton:hover    { background-color: #2F2F2F; }
QPushButton:pressed  { background-color: #7C4DFF; }
QPushButton:disabled { background-color: #2a2a2a; color: #666; }

/* 输入控件：单行/多行文本、数字选择、下拉 */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #242424;
    color: #e0e0e0;
    border: 1px solid #3D3D3D;
    border-radius: 3px;
    padding: 4px 8px;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #242424;
    color: #e0e0e0;
    selection-background-color: #7C4DFF;
    border: 1px solid #3D3D3D;
}

/* 表格/树/列表 */
QTableWidget, QTreeWidget, QListWidget {
    background-color: #252525;
    alternate-background-color: #1A1A1A;
    color: #e0e0e0;
    border: 1px solid #3D3D3D;
    gridline-color: #3D3D3D;
}
QTableWidget::item, QTreeWidget::item { color: #e0e0e0; }
QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #7C4DFF;
    color: #fff;
}
QHeaderView::section {
    background-color: #1F1F1F;
    color: #e0e0e0;
    border: 1px solid #3D3D3D;
    padding: 4px 8px;
}

/* 进度条 */
QProgressBar {
    background-color: #242424;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    text-align: center;
    color: #e0e0e0;
}
QProgressBar::chunk { background-color: #7C4DFF; border-radius: 3px; }

/* 滚动条：隐藏箭头，仅保留滑块 */
QScrollBar:vertical   { background: #121212; width:  12px; margin: 0; }
QScrollBar::handle:vertical { background: #3D3D3D; border-radius: 6px; min-height: 20px; }
QScrollBar:add-line:vertical, QScrollBar:sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #121212; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #3D3D3D; border-radius: 6px; min-width: 20px; }
QScrollBar:add-line:horizontal, QScrollBar:sub-line:horizontal { width: 0; }

/* 标签 / 工具提示 / 状态栏 */
QLabel    { color: #e0e0e0; }
QToolTip  { background-color: #1F1F1F; color: #e0e0e0; border: 1px solid #3D3D3D; padding: 4px; }
QStatusBar { background-color: #242424; color: #aaa; border-top: 1px solid #3D3D3D; }

/* 菜单 */
QMenu {
    background-color: #242424;
    color: #E0E0E0;
    border: 1px solid #3D3D3D;
    padding: 4px 0;
}
QMenu::item         { padding: 6px 32px 6px 16px; }
QMenu::item:selected { background-color: #7C4DFF; color: #fff; }
QMenu::separator    { height: 1px; background-color: #3D3D3D; margin: 4px 8px; }
