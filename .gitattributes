# ============================================================
# Q-DetectVision .gitattributes
# 统一 C++/QML/CMake 文件行尾为 LF
# ============================================================

# 源代码统一为 LF
*.cpp       text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.hpp       text eol=lf
*.cc        text eol=lf
*.qml       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

# Windows 批处理保持 CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf
