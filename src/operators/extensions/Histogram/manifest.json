{
    "type": "Histogram",
    "version": "1.0.0",
    "cnName": "直方图工具",
    "category": "预处理",
    "iconPath": "qrc:/icons/histogram.svg",
    "description": "灰度/彩色直方图计算与均衡化",
    "library": "Histogram.dll",
    "params": [
        {
            "name": "mode",
            "cnName": "模式",
            "type": 2,
            "defaultValue": "gray",
            "options": ["灰度", "彩色", "均衡化"],
            "optionKeys": ["gray", "color", "equalize"],
            "help": "gray=灰度直方图，color=彩色直方图，equalize=直方图均衡化"
        },
        {
            "name": "bins",
            "cnName": "直方图箱数",
            "type": 0,
            "defaultValue": 256,
            "minValue": 1,
            "maxValue": 1024,
            "step": 1,
            "help": "直方图分箱数（1-1024）"
        },
        {
            "name": "rangeMin",
            "cnName": "范围最小值",
            "type": 1,
            "defaultValue": 0.0,
            "minValue": 0.0,
            "maxValue": 255.0,
            "step": 1.0,
            "help": "统计范围下界"
        },
        {
            "name": "rangeMax",
            "cnName": "范围最大值",
            "type": 1,
            "defaultValue": 256.0,
            "minValue": 0.0,
            "maxValue": 256.0,
            "step": 1.0,
            "help": "统计范围上界"
        }
    ]
}
