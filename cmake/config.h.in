#define QDV_VERSION_PATCH @QDetectVision_VERSION_PATCH@
#define QDV_VERSION "@QDetectVision_VERSION@"

#define QDV_DATA_DIR "@CMAKE_INSTALL_DATADIR@/QDetectVision"
