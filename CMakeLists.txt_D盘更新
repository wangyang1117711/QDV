cmake_minimum_required(VERSION 3.16)
project(QDetectVision VERSION 1.0.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# 输出目录
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)

# 构建选项
option(BUILD_TESTS "Enable unit tests" ON)
option(BUILD_PLUGINS "Enable plugin system" ON)
option(ENABLE_GPU "Enable GPU acceleration" OFF)
option(QT_STATIC "Build Qt statically" OFF)

# 项目定义
if(WIN32)
    add_compile_definitions(
        _WINSOCKAPI_
        _WINDOWS
        UNICODE
        _UNICODE
        WIN32_LEAN_AND_MEAN
    )
endif()

# 配置文件
configure_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/cmake/config.h.in
    ${CMAKE_CURRENT_BINARY_DIR}/config.h
)

# CMake 模块路径
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")

# 包含目录
include_directories(
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${CMAKE_CURRENT_SOURCE_DIR}/src
    ${CMAKE_CURRENT_BINARY_DIR}
)

# 设置 Qt6 路径 - 优先使用 D 盘安装
if(WIN32)
    if(NOT CMAKE_PREFIX_PATH)
        set(QT6_POSSIBLE_PATHS
            "D:/Qt/6.5.0/mingw_64"
            "D:/Qt/6.5.0/msvc2022_64"
            "C:/Qt/6.5.0/mingw_64"
            "C:/Qt/6.5.0/msvc2022_64"
        )

        foreach(PATH ${QT6_POSSIBLE_PATHS})
            if(EXISTS "${PATH}")
                message(STATUS "使用 Qt6: ${PATH}")
                list(APPEND CMAKE_PREFIX_PATH "${PATH}")
                break()
            endif()
        endforeach()
    endif()
endif()

# 包含依赖
include(Dependencies)
include(CompilerSettings)

# Qt 自动化处理
set(CMAKE_AUTOMOC ON)
set(CMAKE_AUTORCC ON)
set(CMAKE_AUTOUIC ON)
set(CMAKE_AUTOUIC_SEARCH_PATHS ${CMAKE_CURRENT_SOURCE_DIR}/ui)

# 资源文件
if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/resources/resources.qrc)
    qt_add_resources(RESOURCES
        ${CMAKE_CURRENT_SOURCE_DIR}/resources/resources.qrc
    )
endif()

# 添加子目录
add_subdirectory(src/Core)
add_subdirectory(src/Vision)
add_subdirectory(src/AI)
add_subdirectory(src/Communication)
add_subdirectory(src/UI)
add_subdirectory(src/Database)
add_subdirectory(src/Plugins)

# 测试
if(BUILD_TESTS)
    enable_testing()
    add_subdirectory(tests)
endif()

# 主应用
add_subdirectory(apps/SmartVision)

# 安装规则
include(GNUInstallDirs)
install(TARGETS ${PROJECT_NAME}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
)
install(FILES docs/QtEnvironmentSetup.md DESTINATION ${CMAKE_INSTALL_DOCDIR})